# Opcional: o docker compose já tem padrão para tudo. Copie para .env só para trocar algum valor.
# Só valores de exemplo; segredo real nunca entra no Git.

# local e test logam DEBUG; production loga INFO.
APP_ENV=local
SERVICE_NAME=bootcamp-api

# Usada por quem roda fora do compose (testes). Dentro do compose o host é "db".
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@localhost:5432/bootcamp

# Header INTERNAL-TOKEN exigido nas rotas; os testes leem o mesmo valor.
INTERNAL_TOKEN=default_token

# Host da API para os testes.
SERVER_LOCALHOST=0.0.0.0

# Portas na sua máquina, se a padrão estiver ocupada. Mudou DB_PORT? Ajuste a DATABASE_URL.
#API_PORT=3001
#DB_PORT=5433
#MOCK_PORT=1081

# Birô de CPF. No compose o endereço é fixo no mock (docs/06-operacao/resiliencia.md).
BUREAU_API_URL=http://localhost:1080/bureau
BUREAU_API_INTERNAL_TOKEN=default_token
BUREAU_API_TIMEOUT=5

# Tarifa por transferência (centavos) e limite de contas não encerradas por cliente.
TRANSFER_FEE_CENTS=200
MAX_ACCOUNTS_PER_CUSTOMER=3

# Mock server visto pelos testes.
MOCK_HOST=localhost
