{
  "title": "PostTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "DEPOSIT",
        "TRANSFER"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999999
    },
    "request_control_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "destination_account_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    }
  },
  "required": [
    "type",
    "amount",
    "request_control_key"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "TRANSFER"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "destination_account_key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "DEPOSIT"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "not": {
          "required": [
            "destination_account_key"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
